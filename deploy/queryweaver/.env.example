QW_METADATA_PORT=33306
QW_SOURCE_MYSQL_PORT=33307
QW_SOURCE_POSTGRES_PORT=35432
QW_BACKEND_PORT=28065
QW_FRONTEND_PORT=23000

QW_METADATA_DATABASE=queryweaver
QW_METADATA_USER=queryweaver
QW_METADATA_PASSWORD=replace-with-strong-password
QW_METADATA_VOLUME=queryweaver-metadata-pg16
QW_METADATA_ROOT_PASSWORD=replace-with-strong-root-password
QW_SOURCE_ROOT_PASSWORD=replace-with-strong-source-root-password
QW_READER_PASSWORD=replace-with-strong-readonly-password
QW_POSTGRES_ADMIN=queryweaver_admin
QW_POSTGRES_ADMIN_PASSWORD=replace-with-strong-postgres-password
QW_POSTGRES_READER_PASSWORD=replace-with-strong-postgres-readonly-password

# Generate independent random values before first start. Never commit docker-file/queryweaver/.env.
QUERYWEAVER_EXECUTION_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
QUERYWEAVER_SECRET_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
QUERYWEAVER_JWT_ISSUER_URI=
QUERYWEAVER_SPRING_PROFILE=prod
QUERYWEAVER_SECURITY_ENABLED=true
QUERYWEAVER_OPERATOR_DEVELOPMENT_MODE=false
