# QueryWeaver deployment configuration.
# Copy this file to deploy/queryweaver/.env and fill every required blank value.
# Do not commit the resulting .env file.

QUERYWEAVER_COMPOSE_PROJECT_NAME=queryweaver
QUERYWEAVER_METADATA_PORT=33306
QUERYWEAVER_BACKEND_PORT=28065
QUERYWEAVER_FRONTEND_PORT=23000

QUERYWEAVER_METADATA_DATABASE=queryweaver
QUERYWEAVER_METADATA_USER=queryweaver
QUERYWEAVER_METADATA_PASSWORD=
QUERYWEAVER_METADATA_VOLUME=queryweaver-metadata-pg16
QUERYWEAVER_UPLOADS_VOLUME=queryweaver-uploads
QUERYWEAVER_NETWORK_NAME=queryweaver-net

# Required: generate independent random values before first start.
QUERYWEAVER_EXECUTION_INTERNAL_TOKEN=
QUERYWEAVER_SECRET_ENCRYPTION_KEY=

# Authentication is disabled for the self-contained first start. Enable it after configuring OIDC.
QUERYWEAVER_SECURITY_ENABLED=false
QUERYWEAVER_JWT_ISSUER_URI=
QUERYWEAVER_OPERATOR_DEVELOPMENT_MODE=false
QUERYWEAVER_SPRING_PROFILE=standalone
QUERYWEAVER_MCP_ENABLED=true
QUERYWEAVER_MCP_PUBLIC_BASE_URL=http://127.0.0.1:28065

# Optional image overrides.
QUERYWEAVER_BACKEND_IMAGE=queryweaver/backend:local
QUERYWEAVER_FRONTEND_IMAGE=queryweaver/frontend:local
QUERYWEAVER_EXECUTION_IMAGE=continuumio/anaconda3:latest

# Optional demo datasource profile; unused by the normal app profile.
QUERYWEAVER_DEMO_MYSQL_PORT=33307
QUERYWEAVER_DEMO_MYSQL_ROOT_PASSWORD=
QUERYWEAVER_DEMO_MYSQL_READER_PASSWORD=
QUERYWEAVER_DEMO_POSTGRES_PORT=35432
QUERYWEAVER_DEMO_POSTGRES_ADMIN=queryweaver_admin
QUERYWEAVER_DEMO_POSTGRES_ADMIN_PASSWORD=
QUERYWEAVER_DEMO_POSTGRES_READER_PASSWORD=
